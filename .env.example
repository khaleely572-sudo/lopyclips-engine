# Copy this file to ".env" (same folder) and fill in what you use. ".env" stays on your computer and is
# never committed or shared. Leave a line commented out (#) if you don't need it.

# --- AI models: fill in at least one ------------------------------------------------------------
# NVIDIA NIM (free key at https://build.nvidia.com). Used by models named "nim:...", the default.
NVIDIA_API_KEY=

# Any OpenAI-compatible chat API: OpenAI, OpenRouter, Groq, Together, a local LM Studio...
# Used by models named "openai:..." (for example "openai:gpt-4o-mini"). Set the address if it isn't OpenAI.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local or Ollama cloud models). Used by model names without a prefix.
# OLLAMA_URL=http://127.0.0.1:11434

# --- Your channel ---------------------------------------------------------------------------------
# The channel name shown on every Short.
# LOPYCLIPS_BRAND=LOPYCLIPS

# --- Optional -------------------------------------------------------------------------------------
# Where the clipper's clip_video.py lives, if not in ~/.claude/skills/Youtube-clipper-skill/scripts/
# LOPYCLIPS_CLIPPER_SCRIPT=
# Where the /watch skill lives, if not in ~/.claude/skills/watch
# WATCH_SKILL_DIR=
# Dashboard port
# LOPYCLIPS_PORT=4317
